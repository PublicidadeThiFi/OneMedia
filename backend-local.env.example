# Local backend development env for copy/paste
NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onemedia_local?schema=public
DATABASE_SSL_MODE=disable
ALLOW_INSECURE_DB_SSL=true
WEB_APP_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3333/api
PUBLIC_API_URL=http://localhost:3333/api
UPLOADS_PROVIDER=local
UPLOADS_DIR=./uploads
DEBUG_UPLOADS=true
MAIL_PROVIDER=console
EMAIL_FROM=dev@localhost
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=
OAUTH_FRONTEND_CALLBACK_URL=http://localhost:3000/oauth-callback
GOOGLE_REDIRECT_URI=http://localhost:3333/api/auth/oauth/google/callback

# Optional local placeholders
# S3_BUCKET_NAME=
# AWS_REGION=
# AWS_CLI_PATH=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
